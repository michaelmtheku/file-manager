{
  "name": "file-manager-backend",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint 'src/**/*.{js,mjs,cjs,ts}'",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test METADATA_FILE=metadata.test.json APP_VERSION=$npm_package_version jest --runInBand",
    "format": "prettier --write 'src/**/*.{js,json,md}'"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.1.1"
  }
}
